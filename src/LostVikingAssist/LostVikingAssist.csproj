<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LostVikingAssist</AssemblyName>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Content Include="..\..\vendor\StormLib.dll" Link="StormLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\CascLib.dll" Link="CascLib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
