<Window x:Class="LostVikingAssist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="失落的维京辅助器" Width="760" Height="570" MinWidth="700" MinHeight="540"
        Background="#10151E" Foreground="#E5EBF3" FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8996A8"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCE8F6"/><Setter Property="Background" Value="#202B3B"/>
            <Setter Property="BorderBrush" Value="#344158"/><Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10151E"/><Setter Property="Foreground" Value="#DCE8F6"/>
            <Setter Property="BorderBrush" Value="#344158"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#69D6EC"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5EBF3"/><Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24" Background="#10151E">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="失落的维京辅助器" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22"/>
                <StackPanel x:Name="Settings">
                    <TextBlock Text="游戏目录" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePath" AutomationProperties.Name="游戏安装目录" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="浏览" Click="BrowseGame" Margin="0"/>
                    </Grid>
                    <TextBlock x:Name="ClientInfo" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,20"/>
                    <Border Background="#192230" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Bombs" Content="无限炸弹" IsChecked="True" Margin="0,0,36,0"/>
                                <CheckBox x:Name="Invulnerability" Content="永久无敌" IsChecked="True"/>
                            </StackPanel>
                            <TextBlock Text="保留炸弹冷却、Boss 与成就判定。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="Actions">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="生成地图" Click="BuildMap" Background="#63CADE" Foreground="#09141D" BorderBrush="#63CADE" FontWeight="SemiBold"/>
                        <Button Content="安装补丁" Click="InstallMap"/>
                        <Button Content="恢复原版" Click="RestoreMap"/>
                    </StackPanel>
                    <TextBlock Text="安装与恢复前，请退出游戏和编辑器。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
                </StackPanel>
                <TextBlock x:Name="OperationStatus" Text="就绪" Foreground="#69D6EC" Margin="0,20,0,5"/>
                <TextBlock x:Name="ResultInfo" Text="先生成地图，再安装补丁。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                <Expander Header="更多选项与日志" Foreground="{StaticResource Muted}" Margin="0,20,0,12">
                    <StackPanel Margin="0,12,0,0">
                        <WrapPanel x:Name="ExtraActions">
                            <Button Content="自动检测目录" Click="DetectGame" Padding="10,6"/>
                            <Button Content="导入地图" Click="ImportMap" Padding="10,6"/>
                            <Button Content="使用客户端" Click="UseClient" Padding="10,6"/>
                            <Button Content="检查补丁" Click="CheckInstalled" Padding="10,6"/>
                            <Button Content="打开输出目录" Click="OpenOutput" Padding="10,6" Margin="0"/>
                        </WrapPanel>
                        <TextBlock x:Name="SourceInfo" Text="来源：当前客户端" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,10"/>
                        <TextBox x:Name="LogText" Height="120" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="官方成就入账尚未实测。进入酒吧街机验证；详细步骤见使用说明。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</Window>
